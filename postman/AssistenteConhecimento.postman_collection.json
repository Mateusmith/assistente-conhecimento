{
  "info": {
    "_postman_id": "84a98c0e-8812-49f7-a108-7dff55c66612",
    "name": "Assistente de Conhecimento API",
    "description": "Fluxo completo 1.4: autenticacao com audiencia, ingestao segura, ACL, RAG contextual e citado, rastreabilidade de prompt, conversas idempotentes, avaliacao assincrona, MCP, reindexacao, governanca e LGPD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Infraestrutura",
      "item": [
        {
          "name": "Health check",
          "request": {"method": "GET", "url": "{{base_url}}/actuator/health"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Aplicacao saudavel', () => pm.response.to.have.status(200));", "pm.test('Status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "02 - Autenticacao",
      "item": [
        {
          "name": "Token Ana",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}, {"key": "Host", "value": "localhost:18084"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "grant_type", "value": "password"},
              {"key": "client_id", "value": "contextpilot-postman"},
              {"key": "username", "value": "{{usuario_ana}}"},
              {"key": "password", "value": "{{senha}}"}
            ]},
            "url": "{{keycloak_url}}/realms/contextpilot/protocol/openid-connect/token"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Token Ana emitido', () => pm.response.to.have.status(200));", "const token = pm.response.json().access_token;", "const parte = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');", "const payload = JSON.parse(require('atob')(parte));", "pm.test('Token destinado a API', () => pm.expect([].concat(payload.aud)).to.include('contextpilot-api'));", "pm.environment.set('token_ana', token);"], "type": "text/javascript"}}]
        },
        {
          "name": "Token Carla",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}, {"key": "Host", "value": "localhost:18084"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "grant_type", "value": "password"},
              {"key": "client_id", "value": "contextpilot-postman"},
              {"key": "username", "value": "{{usuario_carla}}"},
              {"key": "password", "value": "{{senha}}"}
            ]},
            "url": "{{keycloak_url}}/realms/contextpilot/protocol/openid-connect/token"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Token Carla emitido', () => pm.response.to.have.status(200));", "pm.environment.set('token_carla', pm.response.json().access_token);"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "03 - Espaco e documentos",
      "item": [
        {
          "name": "Criar espaco",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Operacoes Financeiras {{$timestamp}}\",\n  \"descricao\": \"Conhecimento interno para atendimento\"\n}"},
            "url": "{{base_url}}/api/v1/espacos"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Espaco criado', () => pm.response.to.have.status(201));", "pm.environment.set('espaco_id', pm.response.json().id);"], "type": "text/javascript"}}]
        },
        {
          "name": "Adicionar Carla como leitora",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\"usuarioId\":\"carla\",\"papel\":\"LEITOR\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/membros"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Leitora adicionada', () => pm.response.to.have.status(201));"], "type": "text/javascript"}}]
        },
        {
          "name": "Enviar documento restrito",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}", "type": "text"}],
            "body": {"mode": "formdata", "formdata": [
              {"key": "titulo", "value": "Politica de reembolso", "type": "text"},
              {"key": "visibilidade", "value": "RESTRITO", "type": "text"},
              {"key": "metadados", "value": "{\"departamento\":\"financeiro\",\"tags\":[\"reembolso\",\"politica\"]}", "type": "text"},
              {"key": "arquivo", "type": "file", "src": "{{document_file}}"}
            ]},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/documentos"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Documento aceito', () => pm.response.to.have.status(201));", "const documento = pm.response.json();", "pm.test('Binario salvo no MinIO apos verificacao limpa', () => { pm.expect(documento.armazenamento).to.eql('S3'); pm.expect(documento.resultadoAntivirus).to.eql('LIMPO'); });", "pm.environment.set('documento_id', documento.id);", "pm.environment.set('tentativas_processamento', '0');"], "type": "text/javascript"}}]
        },
        {
          "name": "Consultar processamento",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/documentos/{{documento_id}}"},
          "event": [
            {"listen": "prerequest", "script": {"exec": ["setTimeout(() => {}, 500);"], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": ["pm.test('Documento consultado', () => pm.response.to.have.status(200));", "const documento = pm.response.json();", "const tentativas = Number(pm.environment.get('tentativas_processamento') || 0);", "if (documento.estado === 'FALHOU') { pm.test('Ingestao sem falha', () => pm.expect.fail(documento.erroProcessamento || 'Falha de ingestao')); pm.environment.unset('tentativas_processamento'); } else if (documento.estado !== 'PRONTO' && tentativas < 20) { pm.environment.set('tentativas_processamento', String(tentativas + 1)); pm.execution.setNextRequest(pm.info.requestName); } else { pm.environment.unset('tentativas_processamento'); pm.test('Ingestao nativa concluida', () => { pm.expect(documento.estado).to.eql('PRONTO'); pm.expect(documento.origemTexto).to.eql('NATIVO'); pm.expect(documento.paginasOcr).to.eql(0); }); }"], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Baixar original do MinIO",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/documentos/{{documento_id}}/conteudo"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Documento recuperado', () => pm.response.to.have.status(200));", "pm.test('Conteudo original preservado', () => pm.expect(pm.response.text()).to.include('30 dias'));"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "04 - ACL e RAG",
      "item": [
        {
          "name": "Carla pergunta antes da permissao",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"Qual e o prazo para solicitar reembolso?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/consultas"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Consulta aceita', () => pm.response.to.have.status(200));", "pm.test('Conteudo restrito nao vazou', () => { pm.expect(pm.response.json().recusada).to.eql(true); pm.expect(pm.response.json().fontes).to.be.empty; });"], "type": "text/javascript"}}]
        },
        {
          "name": "Conceder leitura a Carla",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\"usuarioId\":\"carla\",\"nivel\":\"LEITURA\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/documentos/{{documento_id}}/permissoes"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Permissao concedida', () => pm.response.to.have.status(204));"], "type": "text/javascript"}}]
        },
        {
          "name": "Carla pergunta com permissao",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"Qual e o prazo para solicitar reembolso?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/consultas"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('RAG respondeu', () => pm.response.to.have.status(200));", "pm.test('Resposta possui fonte e rastro verificaveis', () => { const r = pm.response.json(); pm.expect(r.recusada).to.eql(false); pm.expect(r.resposta).to.include('[F1]'); pm.expect(r.fontes[0].documentoId).to.eql(pm.environment.get('documento_id')); pm.expect(r.versaoPrompt).to.be.a('string'); pm.expect(r.impressaoPrompt).to.have.lengthOf(64); pm.expect(r.candidatosRecuperados).to.be.at.least(1); pm.expect(r.fontesContexto).to.be.at.least(r.fontes.length); });", "pm.environment.set('consulta_id', pm.response.json().consultaId);"], "type": "text/javascript"}}]
        },
        {
          "name": "Registrar feedback",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}],
            "body": {"mode": "raw", "raw": "{\"util\":true,\"comentario\":\"Resposta objetiva e verificavel\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/consultas/{{consulta_id}}/feedback"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Feedback registrado', () => pm.response.to.have.status(204));"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "05 - Avaliacoes",
      "item": [
        {
          "name": "Criar conjunto",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\"nome\":\"Regressao financeira\",\"descricao\":\"Perguntas criticas do atendimento\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Conjunto criado', () => pm.response.to.have.status(201));", "pm.environment.set('conjunto_id', pm.response.json().id);"], "type": "text/javascript"}}]
        },
        {
          "name": "Adicionar caso",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"pergunta\": \"Qual e o prazo para solicitar reembolso?\",\n  \"termosEsperados\": [\"30 dias\"],\n  \"documentosEsperados\": [\"{{documento_id}}\"],\n  \"deveRecusar\": false,\n  \"latenciaMaximaMs\": 10000,\n  \"custoMaximoUsd\": 1\n}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/casos"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Caso criado', () => pm.response.to.have.status(201));"], "type": "text/javascript"}}]
        },
        {
          "name": "Executar avaliacao base",
          "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/execucoes"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Avaliacao base agendada', () => pm.response.to.have.status(202));", "const r = pm.response.json();", "pm.test('Job retornou identificador', () => pm.expect(r.id).to.be.a('string'));", "pm.environment.set('execucao_base_id', r.id);", "pm.environment.set('poll_base', '0');"], "type": "text/javascript"}}]
        },
        {
          "name": "Aguardar avaliacao base",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/execucoes/{{execucao_base_id}}"},
          "event": [
            {"listen": "prerequest", "script": {"exec": ["setTimeout(() => {}, 500);"], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": ["pm.test('Consulta do job disponivel', () => pm.response.to.have.status(200));", "const r = pm.response.json();", "const tentativa = Number(pm.environment.get('poll_base') || 0) + 1;", "pm.environment.set('poll_base', String(tentativa));", "if (['PENDENTE', 'EXECUTANDO'].includes(r.estado) && tentativa < 40) { pm.execution.setNextRequest(pm.info.requestName); } else { pm.test('Avaliacao base concluida', () => pm.expect(r.estado).to.eql('CONCLUIDA')); pm.test('Metricas perfeitas', () => { pm.expect(r.taxaAcerto).to.eql(1); pm.expect(r.recallMedio).to.eql(1); pm.expect(r.precisaoMedia).to.eql(1); pm.expect(r.mrrMedio).to.eql(1); pm.expect(r.casosProcessados).to.eql(r.totalCasos); }); pm.environment.unset('poll_base'); }"], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Executar avaliacao atual",
          "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/execucoes"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Nova avaliacao agendada', () => pm.response.to.have.status(202));", "pm.environment.set('execucao_atual_id', pm.response.json().id);", "pm.environment.set('poll_atual', '0');"], "type": "text/javascript"}}]
        },
        {
          "name": "Aguardar avaliacao atual",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/execucoes/{{execucao_atual_id}}"},
          "event": [
            {"listen": "prerequest", "script": {"exec": ["setTimeout(() => {}, 500);"], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": ["pm.test('Consulta do job disponivel', () => pm.response.to.have.status(200));", "const r = pm.response.json();", "const tentativa = Number(pm.environment.get('poll_atual') || 0) + 1;", "pm.environment.set('poll_atual', String(tentativa));", "if (['PENDENTE', 'EXECUTANDO'].includes(r.estado) && tentativa < 40) { pm.execution.setNextRequest(pm.info.requestName); } else { pm.test('Avaliacao atual concluida', () => pm.expect(r.estado).to.eql('CONCLUIDA')); pm.environment.unset('poll_atual'); }"], "type": "text/javascript"}}
          ]
        },
        {
          "name": "Comparar com baseline",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/avaliacoes/{{conjunto_id}}/execucoes/{{execucao_atual_id}}/comparacoes/{{execucao_base_id}}"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Comparacao concluida', () => pm.response.to.have.status(200));", "pm.test('Sem regressao', () => { const r = pm.response.json(); pm.expect(r.regressao).to.eql(false); pm.expect(r.deltaRecall).to.eql(0); });"], "type": "text/javascript"}}]
        },
        {
          "name": "Consultar auditoria",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/auditoria"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Auditoria disponivel ao proprietario', () => pm.response.to.have.status(200));", "pm.test('Eventos registrados', () => pm.expect(pm.response.json().length).to.be.above(5));"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "06 - Conversas seguras",
      "item": [
        {
          "name": "Criar conversa",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}],
            "body": {"mode": "raw", "raw": "{\"titulo\":\"Duvidas sobre reembolso\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Conversa criada', () => pm.response.to.have.status(201));", "pm.environment.set('conversa_id', pm.response.json().id);"], "type": "text/javascript"}}]
        },
        {
          "name": "Enviar primeira mensagem",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}, {"key": "Idempotency-Key", "value": "postman-conversa-001"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"Qual e o prazo para solicitar reembolso?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas/{{conversa_id}}/mensagens"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Mensagem respondida', () => pm.response.to.have.status(200));", "const r = pm.response.json();", "pm.test('Resposta validada', () => { pm.expect(r.versao).to.eql(1); pm.expect(r.resposta.recusada).to.eql(false); pm.expect(r.resposta.fontes[0].documentoId).to.eql(pm.environment.get('documento_id')); });", "pm.environment.set('consulta_conversa_id', r.resposta.consultaId);"], "type": "text/javascript"}}]
        },
        {
          "name": "Repetir mensagem idempotente",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}, {"key": "Idempotency-Key", "value": "postman-conversa-001"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"Qual e o prazo para solicitar reembolso?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas/{{conversa_id}}/mensagens"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Retry reutilizado', () => pm.response.to.have.status(200));", "pm.test('Consulta nao duplicada', () => pm.expect(pm.response.json().resposta.consultaId).to.eql(pm.environment.get('consulta_conversa_id')));"], "type": "text/javascript"}}]
        },
        {
          "name": "Pergunta de continuacao",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}, {"key": "Idempotency-Key", "value": "postman-conversa-002"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"E quais dados a solicitacao deve conter?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas/{{conversa_id}}/mensagens"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Continuacao respondida', () => pm.response.to.have.status(200));", "pm.test('Memoria contextual aplicada', () => { const r = pm.response.json(); pm.expect(r.versao).to.eql(2); pm.expect(r.resposta.recusada).to.eql(false); });"], "type": "text/javascript"}}]
        },
        {
          "name": "Responder por SSE validado",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "text/event-stream"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}, {"key": "Idempotency-Key", "value": "postman-stream-001"}],
            "body": {"mode": "raw", "raw": "{\"pergunta\":\"Pode resumir o prazo novamente?\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas/{{conversa_id}}/mensagens/stream"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('SSE concluido', () => pm.response.to.have.status(200));", "const eventos = pm.response.text();", "pm.test('Resposta saiu com fontes e conclusao', () => { pm.expect(eventos).to.include('event:fontes'); pm.expect(eventos).to.include('event:resposta'); pm.expect(eventos).to.include('event:concluido'); });"], "type": "text/javascript"}}]
        },
        {
          "name": "Consultar historico",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_carla}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/conversas/{{conversa_id}}"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Historico consultado', () => pm.response.to.have.status(200));", "pm.test('Tres interacoes persistidas', () => pm.expect(pm.response.json().mensagens).to.have.lengthOf(6));"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "07 - MCP",
      "item": [
        {
          "name": "Inicializar servidor MCP",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json, text/event-stream"},
              {"key": "Authorization", "value": "Bearer {{token_ana}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"postman\",\"version\":\"1.0.0\"}}}"
            },
            "url": "{{base_url}}/mcp"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('MCP inicializado', () => pm.response.to.have.status(200));", "pm.test('Servidor identificado', () => pm.expect(pm.response.json().result.serverInfo.name).to.eql('assistente-conhecimento-mcp'));"], "type": "text/javascript"}}]
        },
        {
          "name": "Listar ferramentas MCP",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json, text/event-stream"},
              {"key": "Authorization", "value": "Bearer {{token_ana}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}"},
            "url": "{{base_url}}/mcp"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Ferramentas listadas', () => pm.response.to.have.status(200));", "pm.test('Tres ferramentas publicadas', () => { const nomes = pm.response.json().result.tools.map(t => t.name); pm.expect(nomes).to.include.members(['listarDocumentos', 'buscarConhecimento', 'consultarComFontes']); pm.expect(nomes).to.have.lengthOf(3); });"], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "08 - Busca, indice e governanca",
      "item": [
        {
          "name": "Comparar estrategias de busca",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_carla}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"pergunta\": \"Qual e o prazo para solicitar reembolso?\",\n  \"filtros\": {\"metadados\": {\"departamento\": \"financeiro\"}, \"tags\": [\"reembolso\"]}\n}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/buscas/comparacoes"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Comparacao concluida', () => pm.response.to.have.status(200));", "pm.test('Tres estrategias retornadas', () => pm.expect(pm.response.json().resultados).to.have.lengthOf(3));"], "type": "text/javascript"}}]
        },
        {
          "name": "Listar modelos de embedding",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/indices-embedding/modelos"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Modelos listados', () => pm.response.to.have.status(200));", "pm.test('Modelo v2 disponivel', () => pm.expect(pm.response.json().map(m => m.modelo)).to.include('local-hashing-v2'));"], "type": "text/javascript"}}]
        },
        {
          "name": "Iniciar reindexacao blue-green",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_ana}}"}],
            "body": {"mode": "raw", "raw": "{\"modelo\":\"local-hashing-v2\"}"},
            "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/indices-embedding"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Reindexacao aceita', () => pm.response.to.have.status(202));", "pm.environment.set('indice_id', pm.response.json().id);"], "type": "text/javascript"}}]
        },
        {
          "name": "Consultar indices apos processamento",
          "event": [
            {"listen": "prerequest", "script": {"exec": ["setTimeout(() => {}, 2500);"], "type": "text/javascript"}},
            {"listen": "test", "script": {"exec": ["pm.test('Indices consultados', () => pm.response.to.have.status(200));", "pm.test('Indice anterior preservado', () => pm.expect(pm.response.json().length).to.be.at.least(2));", "const novo = pm.response.json().find(i => i.id === pm.environment.get('indice_id'));", "pm.test('Novo indice completo ou ativo', () => pm.expect(['ATIVO', 'CONSTRUINDO']).to.include(novo.estado));"], "type": "text/javascript"}}
          ],
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/indices-embedding"}
        },
        {
          "name": "Consultar uso e custos",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_ana}}"}], "url": "{{base_url}}/api/v1/espacos/{{espaco_id}}/governanca/uso"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Uso consultado', () => pm.response.to.have.status(200));", "pm.test('Armazenamento e consumo contabilizados', () => { const uso = pm.response.json(); pm.expect(uso.armazenamentoUsadoBytes).to.be.above(0); pm.expect(uso.consultasHoje).to.be.above(0); });"], "type": "text/javascript"}}]
        },
        {
          "name": "Exportar dados LGPD de Carla",
          "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token_carla}}"}], "url": "{{base_url}}/api/v1/privacidade/exportacao"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Exportacao entregue', () => pm.response.to.have.status(200));", "pm.test('Dados e conversas pertencem a Carla', () => { const r = pm.response.json(); pm.expect(r.usuarioId).to.eql('carla'); pm.expect(r.conversas.length).to.be.above(0); });"], "type": "text/javascript"}}]
        }
      ]
    }
  ]
}

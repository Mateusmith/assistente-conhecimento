      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Recusas seguras",
      "targets": [{"expr": "sum(contextpilot_rag_consultas_total{resultado=\"recusa\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Ingestoes com sucesso",
      "targets": [{"expr": "sum(contextpilot_ingestao_total{resultado=\"sucesso\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Arquivos limpos pelo ClamAV",
      "targets": [{"expr": "sum(contextpilot_antivirus_verificacoes_total{resultado=\"limpo\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "stat",
      "title": "Objetos armazenados",
      "targets": [{"expr": "sum(contextpilot_armazenamento_operacoes_total{operacao=\"gravar\",resultado=\"sucesso\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6}
    },
    {
      "type": "stat",
      "title": "Documentos processados por OCR",
      "targets": [{"expr": "sum(contextpilot_extracao_total{origem=\"ocr\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6}
    },
    {
      "type": "timeseries",
      "title": "Latencia RAG p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(contextpilot_rag_latencia_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "type": "timeseries",
      "title": "Requisicoes HTTP",
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    },
    {
      "type": "stat",
      "title": "Disponibilidade SLO",
      "targets": [{"expr": "contextpilot:slo_disponibilidade:ratio_5m", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 20}
    },
    {
      "type": "stat",
      "title": "Fila de ingestao",
      "targets": [{"expr": "max(contextpilot_ingestao_fila_pendentes)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 20}
    },
    {
      "type": "stat",
      "title": "Custo estimado de IA",
      "targets": [{"expr": "sum(contextpilot_ia_custo_estimado_usd_total)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 20}
    },
    {
      "type": "stat",
      "title": "Reindexacoes em andamento",
      "targets": [{"expr": "max(contextpilot_reindexacao_em_andamento)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 20}
    },
    {
      "type": "timeseries",
      "title": "Tempo medio de ingestao",
      "targets": [{"expr": "sum(rate(contextpilot_ingestao_duracao_seconds_sum[5m])) / clamp_min(sum(rate(contextpilot_ingestao_duracao_seconds_count[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Quotas e rate limiting bloqueados",
      "targets": [{"expr": "sum(rate(contextpilot_governanca_limites_total{resultado=\"bloqueado\"}[5m])) by (tipo)", "legendFormat": "{{tipo}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Qualidade da ultima avaliacao RAG",
      "targets": [
        {"expr": "contextpilot_avaliacao_taxa_acerto", "legendFormat": "taxa de acerto", "refId": "A"},
        {"expr": "contextpilot_avaliacao_recall", "legendFormat": "recall", "refId": "B"},
        {"expr": "contextpilot_avaliacao_precisao", "legendFormat": "precisao", "refId": "C"},
        {"expr": "contextpilot_avaliacao_mrr", "legendFormat": "MRR", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34}
    },
    {
      "type": "timeseries",
      "title": "Conversas e streaming",
      "targets": [
        {"expr": "sum(rate(contextpilot_conversas_interacoes_total[5m])) by (resultado)", "legendFormat": "interacao {{resultado}}", "refId": "A"},
        {"expr": "sum(rate(contextpilot_conversas_streaming_total[5m])) by (resultado)", "legendFormat": "stream {{resultado}}", "refId": "B"},
        {"expr": "sum(rate(contextpilot_conversas_idempotencia_total[5m]))", "legendFormat": "retry reutilizado", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34}
    },
    {
      "type": "stat",
      "title": "Imagens descritas por visao",
      "targets": [{"expr": "sum(contextpilot_visao_total{resultado=\"sucesso\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 42}
    },
    {
      "type": "stat",
      "title": "Avaliacoes aguardando worker",
      "targets": [{"expr": "max(contextpilot_avaliacao_fila_pendentes)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 42}
    },
    {
      "type": "stat",
      "title": "Avaliacoes com lease expirado",
      "targets": [{"expr": "max(contextpilot_avaliacao_leases_expirados)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 42}
    }
